#compdef occ
# occ completion — all code/name pairs generated by `occ __complete`
# (single source of truth: share/occ/models.tsv). No duplicated lists here.
_occ() {
  local -a entries subs cflags
  if (( CURRENT == 2 )); then
    if [[ $PREFIX == -* ]]; then
      subs=(-h:occ\ help --help:occ\ help)
      cflags=(-p:claude\ prompt --print:claude\ print -c:claude\ continue --resume:claude\ resume)
      _describe 'occ flag' subs
      _describe 'claude flag (default model)' cflags
    else
      entries=(${(f)"$(occ __complete 2>/dev/null)"})
      _describe 'model code' entries
    fi
  else
    [[ $PREFIX == -* ]] && _describe 'claude flag' cflags
    _files
  fi
}
compdef _occ occ
